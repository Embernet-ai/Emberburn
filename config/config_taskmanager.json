{
  "OPC_ENDPOINT": "opc.tcp://0.0.0.0:4840/freeopcua/server/",

  "tags": {
    "fragua.<device>.cpu.util_pct": {
      "type": "float",
      "initial_value": 22.0,
      "simulate": true,
      "simulation_type": "bursty_walk",
      "min": 15.0,
      "max": 35.0,
      "step": 2.0,
      "burst_min": 60.0,
      "burst_max": 75.0,
      "burst_interval_seconds": 180.0,
      "burst_duration_min": 20.0,
      "burst_duration_max": 45.0,
      "description": "Fragua device CPU utilization (%)",
      "backfill": { "window_minutes": 120, "sample_interval_seconds": 10 }
    },

    "fragua.<device>.mem.util_pct": {
      "type": "float",
      "initial_value": 50.0,
      "simulate": true,
      "simulation_type": "stepped",
      "min": 40.0,
      "max": 60.0,
      "step_min": 5.0,
      "step_max": 10.0,
      "hold_seconds_min": 90.0,
      "hold_seconds_max": 300.0,
      "description": "Fragua device memory utilization (%)",
      "backfill": { "window_minutes": 120, "sample_interval_seconds": 10 }
    },

    "fragua.<device>.disk.util_pct": {
      "type": "float",
      "initial_value": 27.0,
      "simulate": true,
      "simulation_type": "walk",
      "min": 20.0,
      "max": 35.0,
      "step": 0.15,
      "drift_per_hour": 0.4,
      "description": "Fragua device disk utilization (%)",
      "backfill": { "window_minutes": 120, "sample_interval_seconds": 10 }
    },

    "fragua.<device>.rtos.jitter.core1_us": {
      "type": "float",
      "initial_value": 1.0,
      "simulate": true,
      "simulation_type": "spike_floor",
      "floor": 1.0,
      "floor_noise": 0.1,
      "tick_max": 3.0,
      "tick_probability": 0.05,
      "spike_max": 36.0,
      "spike_probability": 0.0015,
      "description": "RT core 1 scheduling jitter (us) — see the 4.20.0.0 install package's H1 Safety Manual SS5.6, bare-metal 4-core Intel rig, 300s soak, ~1.5M samples",
      "backfill": { "window_minutes": 120, "sample_interval_seconds": 10 }
    },

    "fragua.<device>.rtos.jitter.core2_us": {
      "type": "float",
      "initial_value": 1.0,
      "simulate": true,
      "simulation_type": "spike_floor",
      "floor": 1.0,
      "floor_noise": 0.1,
      "tick_max": 3.0,
      "tick_probability": 0.05,
      "spike_max": 42.0,
      "spike_probability": 0.0015,
      "description": "RT core 2 scheduling jitter (us) — see the 4.20.0.0 install package's H1 Safety Manual SS5.6, bare-metal 4-core Intel rig, 300s soak, ~1.5M samples",
      "backfill": { "window_minutes": 120, "sample_interval_seconds": 10 }
    },

    "fragua.<device>.rtos.jitter.core3_us": {
      "type": "float",
      "initial_value": 1.0,
      "simulate": true,
      "simulation_type": "spike_floor",
      "floor": 1.0,
      "floor_noise": 0.1,
      "tick_max": 3.0,
      "tick_probability": 0.05,
      "spike_max": 31.0,
      "spike_probability": 0.0015,
      "description": "RT core 3 scheduling jitter (us) — see the 4.20.0.0 install package's H1 Safety Manual SS5.6, bare-metal 4-core Intel rig, 300s soak, ~1.5M samples",
      "backfill": { "window_minutes": 120, "sample_interval_seconds": 10 }
    }
  },

  "_comment_update_interval": "UPDATE_INTERVAL is an env var read by OPCUAServer.__init__ (os.getenv('UPDATE_INTERVAL', '2')), NOT a config file key — this JSON key would silently do nothing. Set it in the deploy (Helm values.env or `python3 opcua_server.py -i 10 -c config_taskmanager.json`) to match sample_interval_seconds above.",

  "publishers": {
    "mqtt": {
      "enabled": true,
      "broker_host": "<fragua-mqtt-broker-host>",
      "broker_port": 1883,
      "topic_prefix": "fragua",
      "qos": 0
    },
    "sqlite_persistence": {
      "enabled": true,
      "db_path": "/data/emberburn_history.db",
      "enable_tag_history": true,
      "batch_size": 50
    },
    "rest_api": {
      "enabled": true,
      "host": "0.0.0.0",
      "port": 5000,
      "cors_enabled": true
    }
  }
}
