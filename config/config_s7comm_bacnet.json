{
  "tags": {
    "Temperature": {
      "type": "float",
      "initial_value": 20.0,
      "simulate": true,
      "simulation_type": "random",
      "min": 15.0,
      "max": 25.0,
      "description": "Ambient temperature in Celsius"
    },
    "Pressure": {
      "type": "float",
      "initial_value": 101.3,
      "simulate": true,
      "simulation_type": "random",
      "min": 99.0,
      "max": 103.0,
      "description": "System pressure in kPa"
    },
    "FlowRate": {
      "type": "float",
      "initial_value": 100.0,
      "simulate": true,
      "simulation_type": "sine",
      "amplitude": 20.0,
      "offset": 100.0,
      "period": 30,
      "description": "Flow rate in L/min"
    },
    "Counter": {
      "type": "int",
      "initial_value": 0,
      "simulate": true,
      "simulation_type": "increment",
      "increment": 1,
      "max": 1000,
      "reset_on_max": true,
      "description": "Production counter"
    },
    "Status": {
      "type": "string",
      "initial_value": "Running",
      "simulate": false,
      "description": "System status message"
    },
    "IsRunning": {
      "type": "bool",
      "initial_value": true,
      "simulate": false,
      "description": "System running flag"
    }
  },
  "publishers": {
    "rest_api": {
      "enabled": true,
      "host": "0.0.0.0",
      "port": 5000
    },
    "s7comm": {
      "enabled": true,
      "port": 102,
      "db": 1,
      "db_size": 1024
    },
    "bacnet": {
      "enabled": true,
      "host": "0.0.0.0",
      "port": 47808,
      "prefix": 24,
      "device_instance": 1234
    }
  }
}
